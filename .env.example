# Base de datos PostgreSQL (ej. Neon: https://neon.tech, plan gratis).
# DATABASE_URL: la conexión "pooled" (agrupada, recomendada para el tráfico normal de la app).
# DIRECT_URL: la conexión directa, sin agrupar — se usa solo para crear/actualizar tablas.
# En Neon, ambas aparecen al crear el proyecto (o en Dashboard > Connection Details).
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Opcional: si no se configura NINGUNA, la app usa un generador de
# respuestas "mock" para que puedas probar todo el flujo sin necesidad de
# una API key todavía. Si configuras varias, se prioriza en este orden:
# ANTHROPIC_API_KEY > DEEPSEEK_API_KEY > GEMINI_API_KEY > GROQ_API_KEY >
# OPENROUTER_API_KEY.
# GEMINI_API_KEY: alternativa con tier gratis — key gratuita en
# https://aistudio.google.com/apikey (requiere cuenta de Google sin
# restricción de edad/supervisión familiar).
# GROQ_API_KEY: otra alternativa con tier gratis — key gratuita en
# https://console.groq.com/keys
# OPENROUTER_API_KEY: otra alternativa con tier gratis (modelos ":free") —
# key gratuita en https://openrouter.ai/keys
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# NextAuth (login con correo y contraseña). Genera un valor propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio"
# En local/Codespaces deja localhost. En Vercel, usa la URL real de tu deploy
# (ej. "https://vigilia.vercel.app").
NEXTAUTH_URL="http://localhost:3000"
