DATABASE_URL="file:./dev.db"

# Opcional: si no se configura, la app usa un generador de respuestas "mock"
# para que puedas probar todo el flujo sin necesidad de una API key todavía.
ANTHROPIC_API_KEY=

# NextAuth (login con correo y contraseña). Genera un valor propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
